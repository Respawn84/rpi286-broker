# Copia este fichero a api.env y pon tu clave real.
# api.env NUNCA debe compartirse ni subirse a git.
ANTHROPIC_API_KEY=tu-clave-aqui

# Opcional: token del bot de Telegram (opcion 7 del menu). Se saca
# hablando con @BotFather y mandandole /newbot. Sin esta linea, la
# seccion de Telegram simplemente avisa de que no esta configurada.
TELEGRAM_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
